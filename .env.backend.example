# --- Access Token Settings ---
ACCESS_TOKEN__RESET_PASSWORD_TOKEN_SECRET=your-reset-password-secret
ACCESS_TOKEN__VERIFICATION_TOKEN_SECRET=your-verification-token-secret
ACCESS_TOKEN__LIFETIME_SECONDS=3600

# --- API Settings ---
API__TITLE=Numismatist
API__DESCRIPTION='API for numismatist system'
API__VERSION=0.0.1
API__PORT=8000
API__CORS_ORIGINS=["*"]

# --- Database Settings ---
DATABASE__HOST=numismatist_db
DATABASE__PORT=5432
DATABASE__USER=backend_pg_user
DATABASE__PASSWORD=backend_pg_password
DATABASE__NAME=backend_pg_database
DATABASE__DEBUG=false
DATABASE__POOL_SIZE=100
DATABASE__MAX_OVERFLOW=50

# --- Logger Settings ---
LOGGER__LEVEL=DEBUG

# --- Storage Settings ---
# Storage backend: "s3" for production/MinIO, "local" for testing
STORAGE__BACKEND=s3

# MinIO/S3 Configuration
STORAGE__ENDPOINT_URL=http://minio:9000
STORAGE__ACCESS_KEY=minioadmin
STORAGE__SECRET_KEY=minioadmin
STORAGE__BUCKET_NAME=numismatist
STORAGE__REGION=us-east-1
STORAGE__PUBLIC_URL=http://localhost:9000/numismatist

# For production S3, use these instead:
# STORAGE__BACKEND=s3
# STORAGE__ENDPOINT_URL=  # Leave empty for AWS S3
# STORAGE__ACCESS_KEY=your-aws-access-key
# STORAGE__SECRET_KEY=your-aws-secret-key
# STORAGE__BUCKET_NAME=your-s3-bucket
# STORAGE__REGION=us-east-1
# STORAGE__PUBLIC_URL=https://your-cloudfront-domain.cloudfront.net

# For local development without MinIO:
# STORAGE__BACKEND=local
# STORAGE__LOCAL_PATH=uploads
# STORAGE__PUBLIC_URL=http://localhost:8099
